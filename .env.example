# ShikenPhi — Exam Session Service
# Copy this file to .env and fill in your values

# Server
SHIKENPHI_PORT=8088
SHIKENPHI_ENVIRONMENT=development

# Database (MongoDB)
SHIKENPHI_MONGO_URL=mongodb://localhost:27019/shikenphi
SHIKENPHI_MONGO_DB=shikenphi

# Auth (JWKS from AuthPhi — do NOT include /.well-known/jwks.json)
SHIKENPHI_AUTH_JWKS_URL=http://localhost:8080

# MondaiPhi integration
SHIKENPHI_MONDAIPHI_URL=http://localhost:8087

# Leaderboard
SHIKENPHI_LEADERBOARD_REFRESH_INTERVAL=5m

# Service-to-service auth (must match MondaiPhi's MONDAIPHI_SERVICE_SECRET)
SHIKENPHI_MONDAIPHI_SERVICE_SECRET=change_me_in_production
